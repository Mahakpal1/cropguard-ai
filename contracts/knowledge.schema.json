{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CropGuard knowledge entry",
  "type": "object",
  "required": [
    "id",
    "crop",
    "disease",
    "type",
    "healthy",
    "symptoms",
    "do_now",
    "avoid_extra",
    "prevent",
    "sources",
    "review"
  ],
  "additionalProperties": false,
  "$defs": {
    "i18n": {
      "type": "object",
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "hi": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "i18nList": {
      "type": "object",
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hi": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {
      "type": "string"
    },
    "crop": {
      "$ref": "#/$defs/i18n"
    },
    "disease": {
      "$ref": "#/$defs/i18n"
    },
    "scientific_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "fungal",
        "oomycete",
        "bacterial",
        "viral",
        "pest",
        "healthy"
      ]
    },
    "healthy": {
      "type": "boolean"
    },
    "symptoms": {
      "$ref": "#/$defs/i18nList"
    },
    "do_now": {
      "$ref": "#/$defs/i18nList"
    },
    "avoid_extra": {
      "$ref": "#/$defs/i18nList"
    },
    "prevent": {
      "$ref": "#/$defs/i18nList"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "note": {
          "type": "string"
        },
        "reviewed_by": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    }
  }
}